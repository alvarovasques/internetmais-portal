# ─── Aplicação ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000

# ─── Banco ───────────────────────────────────────────────────────────────
# Em produção o host é o serviço "postgres" da stack.
DATABASE_URL=postgres://internetmais:senha@localhost:5432/internetmais
POSTGRES_PASSWORD=troque-esta-senha

# ─── Sessão ──────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 48
# Trocar este valor derruba todas as sessões ativas.
SESSION_SECRET=
TOTP_ISSUER=Internet Mais

# ─── Cielo ───────────────────────────────────────────────────────────────
# sandbox enquanto o credenciamento não sai; production depois de homologar.
CIELO_AMBIENTE=sandbox
CIELO_MERCHANT_ID=
CIELO_MERCHANT_KEY=
