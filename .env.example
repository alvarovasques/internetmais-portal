# ─── Aplicação ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000

# ─── Banco ───────────────────────────────────────────────────────────────
# Em produção o host é o serviço "postgres" da stack.
DATABASE_URL=postgres://internetmais:senha@localhost:5432/internetmais
POSTGRES_PASSWORD=troque-esta-senha

# ─── Sessão ──────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 48
# Trocar este valor derruba todas as sessões ativas.
SESSION_SECRET=
TOTP_ISSUER=Internet Mais

# ─── IXC ─────────────────────────────────────────────────────────────────
# O IXC é o dono do cadastro, do contrato e do faturamento. A Cielo já está
# integrada lá, então o site nunca fala com a Cielo direto.
IXC_HOST=https://sistema.internetmais.net
# Formato id:hash, gerado no cadastro do usuário de API do IXC.
# É credencial: nunca versionar. Se vazar, rotacione no IXC.
IXC_TOKEN=
# Só ligar se o IXC usar certificado autoassinado.
IXC_TLS_INSEGURO=false
# Ids que variam por instalação. Confirme os valores reais no IXC antes de
# ligar a venda online: id errado gera OS órfã ou erro na criação.
IXC_ID_FILIAL=
IXC_ID_ASSUNTO_INSTALACAO=
IXC_SETOR_INSTALACAO=
# Tabela da aba "Arquivos" do cliente no webservice. O recurso existe no IXC,
# mas o nome da tabela não está na wiki: confirmar com o suporte antes de
# preencher. Vazio = documento fica retido para anexo manual pelo painel.
IXC_TABELA_ARQUIVOS_CLIENTE=

# ─── Geração de imagens ──────────────────────────────────────────────────
# Só é usada por scripts/gerar-imagens.py, nunca pela aplicação em produção.
# Chave do Google AI Studio, para o modelo de imagem do Gemini (Nano Banana).
GEMINI_API_KEY=
